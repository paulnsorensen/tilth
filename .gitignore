# Build artifacts
/target
spikes/*/target/
/result
/result-*

# Internal docs (reviews, feedback, specs). The public reference pages that README.md links stay tracked.
/docs/*
!/docs/cli.md
!/docs/hosts.md
!/docs/mcp.md

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Serena tooling — track project.yml, ignore cache + local overrides
.serena/*
!.serena/project.yml

# Cheese workflow artifacts stay local; durable knowledge goes to .hallouminate/wiki
.cheese/

# Python
__pycache__/
*.pyc

# Benchmark
benchmark/fixtures/repo/
benchmark/fixtures/repos/
benchmark/results/*.jsonl
benchmark/results/*.md
benchmark/results/*.log
benchmark/results/streams/
benchmark/results/judge/
benchmark/results/configs/
benchmark/results/evolve/
benchmark/results/candidates/
!benchmark/results/.gitkeep

# Local env (API keys, secrets)
.env

# Claude Code local settings (machine-specific)
.claude/settings.local.json
