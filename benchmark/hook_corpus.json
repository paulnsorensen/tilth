{
  "version": 1,
  "must_deny": [
    {"command": "cat src/lib.rs", "rule": "cat"},
    {"command": "tac f", "rule": "tac"},
    {"command": "head -n 5 src/a.go", "rule": "head"},
    {"command": "tail -n 20 build.log", "rule": "tail"},
    {"command": "less README.md", "rule": "less"},
    {"command": "more README.md", "rule": "more"},
    {"command": "nl src/a.go", "rule": "nl"},
    {"command": "bat src/a.go", "rule": "bat"},
    {"command": "sed -n 1,5p src/a.go", "rule": "sed"},
    {"command": "awk '{print $1}' data.txt", "rule": "awk"},
    {"command": "gawk '{print $1}' data.txt", "rule": "gawk"},
    {"command": "mawk '{print $1}' data.txt", "rule": "mawk"},
    {"command": "gsed -n 1p src/a.go", "rule": "gsed"},
    {"command": "sort f", "rule": "sort"},
    {"command": "uniq f", "rule": "uniq"},
    {"command": "cut -d, -f1 data.csv", "rule": "cut"},
    {"command": "wc -l src/a.go", "rule": "wc"},
    {"command": "tr a b f", "rule": "tr"},
    {"command": "diff a.txt b.txt", "rule": "diff"},
    {"command": "cmp a.bin b.bin", "rule": "cmp"},
    {"command": "od -c f", "rule": "od"},
    {"command": "xxd f", "rule": "xxd"},
    {"command": "hexdump -C f", "rule": "hexdump"},
    {"command": "strings a.out", "rule": "strings"},
    {"command": "base64 f", "rule": "base64"},
    {"command": "jq . package.json", "rule": "jq"},
    {"command": "yq .name config.yaml", "rule": "yq"},
    {"command": "< src/a.go grep x", "rule": "input redirect"},
    {"command": "echo $(< f)", "rule": "input redirect"},
    {"command": "wc -l < src/a.go", "rule": "input redirect"},
    {"command": "ls | xargs cat", "rule": "cat"},
    {"command": "git ls-files | xargs head -n 3", "rule": "head"},
    {"command": "find . -exec cat {} +", "rule": "find -exec"},
    {"command": "find . -type f -execdir wc -l {} \\;", "rule": "find -execdir"},
    {"command": "find . -ok rm {} \\;", "rule": "find -ok"},
    {"command": "find . -okdir rm {} \\;", "rule": "find -okdir"},
    {"command": "git show HEAD:src/a.go", "rule": "git show rev:path"},
    {"command": "git -C /tmp/repo show main:README.md", "rule": "git show rev:path"},
    {"command": "git cat-file -p HEAD:src/a.go", "rule": "git cat-file"},
    {"command": "python3 -m json.tool data.json", "rule": "python -m json.tool"},
    {"command": "cp f /dev/stdout", "rule": "device path"},
    {"command": "cp f /dev/fd/1", "rule": "device path"},
    {"command": "cp f /proc/self/fd/1", "rule": "device path"},
    {"command": "echo hi > /dev/tty", "rule": "device path"},
    {"command": "cp f /dev/stderr", "rule": "device path"},
    {"command": "grep foo src/a.go", "rule": "grep"},
    {"command": "grep -rn foo .", "rule": "grep"},
    {"command": "ls | grep -r foo", "rule": "grep"},
    {"command": "ls | xargs grep foo", "rule": "grep"},
    {"command": "egrep 'a|b' src/a.go", "rule": "egrep"},
    {"command": "fgrep foo src/a.go", "rule": "fgrep"},
    {"command": "rg foo src", "rule": "rg"},
    {"command": "rg foo", "rule": "rg"},
    {"command": "ag foo", "rule": "ag"},
    {"command": "ack foo src", "rule": "ack"},
    {"command": "git grep foo", "rule": "git grep"},
    {"command": "echo x > f", "rule": "output redirect"},
    {"command": "echo x >> f", "rule": "output redirect"},
    {"command": "go test ./... > out.txt", "rule": "output redirect"},
    {"command": "go test ./... 2> err.txt", "rule": "output redirect"},
    {"command": "cat <<EOF > f\nhello\nEOF", "rule": "output redirect"},
    {"command": "cmd | tee f", "rule": "tee"},
    {"command": "go test ./... | tee -a log.txt", "rule": "tee"},
    {"command": "sed -i s/a/b/ f.go", "rule": "sed -i"},
    {"command": "sed -i.bak s/a/b/ f.go", "rule": "sed -i"},
    {"command": "sed --in-place s/a/b/ f.go", "rule": "sed -i"},
    {"command": "perl -pi -e s/a/b/ f.go", "rule": "perl -i"},
    {"command": "awk -i inplace '{print}' f", "rule": "awk -i inplace"},
    {"command": "patch -p1 change.diff", "rule": "patch"},
    {"command": "git apply change.diff", "rule": "git apply"},
    {"command": "dd if=a of=b", "rule": "dd"},
    {"command": "truncate -s 0 f", "rule": "truncate"},
    {"command": "python3 - <<EOF\nprint(1)\nEOF", "rule": "python"},
    {"command": "python -c 'print(1)'", "rule": "python"},
    {"command": "echo 'print(1)' | python3", "rule": "python"},
    {"command": "python3 <<< 'print(1)'", "rule": "python"},
    {"command": "perl -e 'print 1'", "rule": "perl"},
    {"command": "perl -ne 'print' f", "rule": "perl"},
    {"command": "ruby -e 'puts 1'", "rule": "ruby"},
    {"command": "node -e 'console.log(1)'", "rule": "node"},
    {"command": "node --eval 'console.log(1)'", "rule": "node"},
    {"command": "deno eval 'console.log(1)'", "rule": "deno"},
    {"command": "bun -e 'console.log(1)'", "rule": "bun"},
    {"command": "php -r 'echo 1;'", "rule": "php"},
    {"command": "bash -c \"cat f\"", "rule": "cat"},
    {"command": "sh -c 'grep -r x .'", "rule": "grep"},
    {"command": "bash -lc 'echo x > f'", "rule": "output redirect"},
    {"command": "echo 'cat f' | bash", "rule": "shell stdin"},
    {"command": "bash -c \"$CMD\"", "rule": "shell -c unresolved"},
    {"command": "eval $CMD", "rule": "shell -c unresolved"},
    {"command": "echo \"$(", "rule": "parse error"},
    {"command": "echo $(cat f)", "rule": "cat"},
    {"command": "x=$(cat f)", "rule": "cat"},
    {"command": "(cat f)", "rule": "cat"},
    {"command": "echo <(cat a)", "rule": "cat"},
    {"command": "true && cat f", "rule": "cat"},
    {"command": "/bin/cat f", "rule": "cat"},
    {"command": "\\cat f", "rule": "cat"},
    {"command": "env FOO=1 cat f", "rule": "cat"},
    {"command": "sudo -u root cat f", "rule": "cat"},
    {"command": "perl -E 'say 1'", "rule": "perl"},
    {"command": "cat 2>/dev/null src/lib.rs", "rule": "cat"},
    {"command": "sed 2>/dev/null -i s/a/b/ f", "rule": "sed -i"},
    {"command": "cat <<EOF src/lib.rs\nx\nEOF", "rule": "cat"},
    {"command": "bash <(echo ls)", "rule": "shell stdin"},
    {"command": "source /dev/stdin", "rule": "shell stdin"},
    {"command": "source $SCRIPT", "rule": "shell -c unresolved"},
    {"command": "timeout -s KILL 5 cat f", "rule": "cat"},
    {"command": "xargs -n 1 cat", "rule": "cat"},
    {"command": "env --bogus go test", "rule": "shell -c unresolved"},
    {"command": "cat <<EOF 2>/dev/null f\nx\nEOF", "rule": "cat"},
    {"command": "grep x <<EOF 2>&1 f\nx\nEOF", "rule": "grep"},
    {"command": "sh $X <<<'cat f'", "rule": "shell -c unresolved"},
    {"command": "bash \"$S\"", "rule": "shell -c unresolved"},
    {"command": "xargs -a f echo", "rule": "input redirect"},
    {"command": "xargs --arg-file=src/lib.rs echo", "rule": "input redirect"},
    {"command": "sudo FOO=1 cat f", "rule": "cat"},
    {"command": "command time -o out.txt ls", "rule": "output redirect"}
  ],
  "must_allow": [
    {"command": "go test ./..."},
    {"command": "go test -race -count=1 -run TestRender ./render/..."},
    {"command": "go build ./..."},
    {"command": "go vet ./..."},
    {"command": "gofmt -l ."},
    {"command": "cargo test"},
    {"command": "cargo test -p x"},
    {"command": "cargo build"},
    {"command": "cargo build --release"},
    {"command": "cargo clippy --all-targets -- -D warnings"},
    {"command": "cargo fmt --check"},
    {"command": "python -m pytest tests/a.py -x"},
    {"command": "python3 -m pytest -q tests"},
    {"command": "python -m unittest discover -s tests"},
    {"command": "python script.py --flag"},
    {"command": "python --version"},
    {"command": "echo '{}' | python -m json.tool"},
    {"command": "pytest -q tests"},
    {"command": "pytest tests/test_a.py::test_b -x"},
    {"command": "pytest -q 2>&1 | tail -5"},
    {"command": "npm test"},
    {"command": "npm run build"},
    {"command": "npx jest --ci"},
    {"command": "yarn test"},
    {"command": "pnpm test"},
    {"command": "node --test"},
    {"command": "node app.js"},
    {"command": "node -v"},
    {"command": "tsc --noEmit"},
    {"command": "make test"},
    {"command": "make -j4 build"},
    {"command": "bash -c \"go test ./...\""},
    {"command": "sh -c 'cargo test -p x'"},
    {"command": "bash run.sh"},
    {"command": "go test ./... 2>&1 | grep FAIL"},
    {"command": "go test ./... 2>&1 | tail -20"},
    {"command": "cargo test 2>&1 | grep -E 'test result|FAILED'"},
    {"command": "go test ./... > /dev/null 2>&1"},
    {"command": "cargo build 2>/dev/null"},
    {"command": "git status"},
    {"command": "git diff"},
    {"command": "git diff --stat"},
    {"command": "git diff | grep foo"},
    {"command": "git show HEAD"},
    {"command": "git show --stat HEAD"},
    {"command": "git log --oneline | head -5"},
    {"command": "git -C /tmp/repo log -3"},
    {"command": "git ls-files | xargs echo"},
    {"command": "cp a b"},
    {"command": "mv a b"},
    {"command": "rm -f a"},
    {"command": "mkdir -p out/dir"},
    {"command": "ls src"},
    {"command": "ls -la | wc -l"},
    {"command": "ls | sort"},
    {"command": "echo hi"},
    {"command": "echo hi 2>&1"},
    {"command": "echo hi >&2"},
    {"command": "echo hi > /dev/null"},
    {"command": "pwd"},
    {"command": "which go"},
    {"command": "find . -name '*.go'"},
    {"command": "echo x | rg foo"},
    {"command": "echo x | sed 's/x/y/'"},
    {"command": "echo x | awk '{print $1}'"},
    {"command": "curl -s http://localhost:8080/health | jq .status"},
    {"command": "cd src && go test ./..."},
    {"command": "FOO=1 cargo test"},
    {"command": "timeout 60 go test ./..."},
    {"command": "env FOO=1 go test ./..."}
  ]
}
