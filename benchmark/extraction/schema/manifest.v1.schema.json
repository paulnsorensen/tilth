{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "fixtures"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/fixture"
      }
    }
  },
  "definitions": {
    "fixture": {
      "type": "object",
      "required": [
        "id",
        "source",
        "language",
        "hash",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "rust",
            "typescript",
            "python"
          ]
        },
        "hash": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "definitions",
            "nesting",
            "signatures",
            "imports",
            "edit_spans"
          ],
          "additionalProperties": false,
          "properties": {
            "definitions": {
              "$ref": "#/definitions/capability"
            },
            "nesting": {
              "$ref": "#/definitions/capability"
            },
            "signatures": {
              "$ref": "#/definitions/capability"
            },
            "imports": {
              "$ref": "#/definitions/capability"
            },
            "edit_spans": {
              "$ref": "#/definitions/capability"
            }
          }
        },
        "known_tilth_divergence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "applicability",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "inapplicable"
          ]
        },
        "expected": {},
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
