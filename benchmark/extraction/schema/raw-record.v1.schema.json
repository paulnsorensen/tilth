{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "fixture_id",
    "language",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "start_line",
        "span_start_line",
        "end_line",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "start_line": {
          "type": "integer",
          "minimum": 0
        },
        "span_start_line": {
          "type": "integer",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "minimum": 0
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "doc": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/entry"
          }
        }
      }
    }
  }
}
